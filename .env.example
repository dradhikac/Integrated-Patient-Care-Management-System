# Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=ipcms-super-secret-key-change-this-in-production-2026

# Database Configuration (MySQL Recommended)
# For MySQL local/remote host:
# DB_TYPE=mysql
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=ipcms_db

# Dual Database Fallback:
# If DB_TYPE is set to sqlite or if MySQL credentials are empty/invalid, 
# app defaults to local SQLite file `sqlite:///ipcms.db`
DB_TYPE=sqlite
DB_NAME=ipcms.db

# Mail Server Settings (for Forgot Password / OTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=noreply.ipcms@gmail.com
MAIL_PASSWORD=your_app_password
